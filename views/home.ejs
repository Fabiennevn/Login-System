<%- include("./partials/header.ejs") %>

<div class="wrapper">
    <div class="content rounded">
        <form method="post" action="/login" class="d-flex flex-column">
            <img class="mb-4" src="/assets/user.svg" alt="user" width="72" height="57">
            
            <% if (locals.message) { %>
              <h1 class="h3 mb-3 fw-normal"> <%= message %> </h1>
            <% }else { %>
              <h1 class="h3 mb-3 fw-normal">Please sign in by entering your DID and your signed challenge</h1>
              <p><%= nonce %></p>
            <% }%>

        
            <div class="form-floating mb-3">
              <input type="text" class="form-control" id="floatingDid" placeholder="Your DID" name="did">
              <label for="floatingPassword">Your DID</label>
            </div>

            <div class="form-floating mb-3">
              <input type="text" class="form-control" id="floatingChallenge" placeholder="signedChallenge" name="signedChallenge">
              <label for="floatingPassword">Signed Challenge</label>
            </div>
        
            <button class="btn btn-primary w-80 py-2" type="submit">Sign in</button>

          </form>
          <hr class="featurette-divider">
          <div>
            <a href="/signup" class="btn btn-primary w-100 py-2">New User? Sign Up!</a>
          </div>
    </div>
</div>

<%- include("./partials/footer.ejs") %>
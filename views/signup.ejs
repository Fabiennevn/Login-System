<%- include("./partials/header.ejs") %>

<div class="wrapper">
    <div class="content rounded">
        <form method="post" action="/signup" class="d-flex flex-column">
            <img class="mb-4" src="/assets/user.svg" alt="user" width="72" height="57">
            <h1 class="h3 mb-3 fw-normal">Please sign up</h1>
        
            <div class="form-floating">
              <input type="text" class="form-control" id="floatingInput" placeholder="Choose a username" name="username">
              <label for="floatingInput">Username</label>
            </div>

            <div class="form-floating">
              <input type="text" class="form-control" id="floatingInput" placeholder="DID" name="did">
              <label for="floatingInput">DID</label>
            </div>
        
            <button class="btn btn-primary w-80 py-2" type="submit">Sign up</button>

          </form>
    </div>
</div>

<%- include("./partials/footer.ejs") %>